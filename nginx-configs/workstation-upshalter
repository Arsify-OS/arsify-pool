        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Archivist Agent (9124)
    location /hermes/archivist {
        proxy_pass http://127.0.0.1:9124;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Frontend Agent (9125)
    location /hermes/frontend {
        proxy_pass http://127.0.0.1:9125;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Backend Agent (9126)
    location /hermes/backend {
        proxy_pass http://127.0.0.1:9126;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Workstation Agent (9127)
    location /hermes/workstation {
        proxy_pass http://127.0.0.1:9127;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Flowforce Agent (9128) - NEW
    location /hermes/flowforce {
        proxy_pass http://127.0.0.1:9128;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # VPSO Unit Upshalternal Manager (upshalter agent)
    location /hermes/VPSO {
        proxy_pass http://127.0.0.1:8645;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Documentation
    location /hermes/docs/ {
        alias /var/www/workstation/hermes/docs/;
        index index.html;
    }

    # Dashboard (Workforce Command Center)
    location /hermes/dashboard/ {
        alias /var/www/workstation/hermes/dashboard/;
        index index.html;
    }

    # Profile page
    location /hermes/profile/ {
        alias /var/www/workstation/hermes/profile/;
        index index.html;
    }

    # Skills page
    location /hermes/skill/ {
        alias /var/www/workstation/hermes/skill/;
        index index.html;
    }

    # Tools page
    location /hermes/tool/ {
        alias /var/www/workstation/hermes/tool/;
        index index.html;
    }

    # Arsify - Shared Knowledge Pool
    location /hermes/arsify/ {
        alias /var/www/workstation/hermes/arsify/;
        index index.html;
    }

    # Lobby - Virtual Office Lobby
    location /hermes/lobby/ {
        alias /var/www/workstation/hermes/lobby/;
        index index.html;
    }

    # Status - Service Health Monitor
    location /hermes/status/ {
        alias /var/www/workstation/hermes/status/;
        index index.html;
    }

    # Root index for /hermes/ and /hermes
    location /hermes/ {
        alias /var/www/workstation/hermes/;
        index index.html;
        try_files $uri $uri/ /hermes/index.html;
    }
    location = /hermes {
        return 301 /hermes/;
    }

    # Health check
    location /health {
        access_log off;
        return 200 "OK\n";
        add_header Content-Type text/plain;
    }

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/workstation.upshalter.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/workstation.upshalter.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    if ($host = workstation.upshalter.com) {
        return 301 https://$host$request_uri;
    }
    listen 80;
    server_name workstation.upshalter.com;
    return 404;
}