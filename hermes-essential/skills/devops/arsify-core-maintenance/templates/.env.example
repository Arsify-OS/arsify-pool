# OpenRouter (Required)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini

# SKP Database (Optional, auto-detects)
SKP_DB_PATH=/data/arsify.db

# Script Directory (Optional, defaults to script location)
SCRIPT_DIR=/opt/arsify-core

# Upshalter Cognitive Engine (Optional, for Upshalter gateway mode)
UPSHALTER_API=http://localhost:8100
UPSHALTER_API_KEY=your-upshalter-key

# Telegram Notification (Optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-chat-id
